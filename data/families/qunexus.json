{
  "$schema": "../schemas/kmi_family.schema.json",
  "schemaVersion": 2,
  "id": "qunexus",
  "name": "QuNexus",
  "summary": "Three-port family with legacy unnamed ports and newer named ports. Bootloader is distinguished by PID MSB rather than a dedicated bootloader PID.",
  "discovery": {
    "familyMarkers": ["QuNexus", "QuNexus Control Surface", "QuNexus Expander", "QuNexus CV"],
    "safeProbeRoles": {
      "application": ["control_surface", "port1"],
      "bootloader": ["bootloader", "port1"]
    },
    "avoidProbeRoles": ["expander", "cv"]
  },
  "identity": {
    "manufacturerId": [0, 1, 95],
    "applicationPidLsb": [24],
    "bootloaderPidLsb": [25],
    "stateDetection": {
      "applicationPidMsb": 0,
      "bootloaderPidMsb": 1
    },
    "notes": [
      "Application PID was 25 prior to named-port support; current firmware (QuNexus_Firmware/code/USB/USB_Descriptor.h) reports 24. Corrected 2026-07-28 - this file previously still listed 25."
    ]
  },
  "payloads": [
    {
      "id": "enter_bootloader",
      "type": "bootloader_entry",
      "targetState": "application",
      "path": "syx/QuNexus/QunexusEnterBootloader.syx",
      "notes": ["Requests a reboot into bootloader mode for QuNexus devices."]
    },
    {
      "id": "firmware_2_2_0",
      "type": "firmware",
      "targetState": "bootloader",
      "version": "2.2.0",
      "path": "syx/QuNexus/QuNexus_Firmware_v2.2.0.syx",
      "notes": [
        "Single monolithic SysEx message, not Hex_to_SysEx-chunked. Superseded by firmware_2_2_0_cs512 - kept until the chunked payload is hardware-validated."
      ]
    },
    {
      "id": "firmware_2_2_0_cs512",
      "type": "firmware",
      "targetState": "bootloader",
      "version": "2.2.0",
      "path": "syx/QuNexus/QuNexus Firmware v2.2.0_cs512.syx",
      "notes": [
        "Chunk-safe (-cs512) packaging via QuNexus's SysEx_and_Hex_Images/make_sysex_app.ps1.",
        "Superseded by firmware_2_2_1_cs512."
      ]
    },
    {
      "id": "firmware_2_2_1_cs512",
      "type": "firmware",
      "targetState": "bootloader",
      "version": "2.2.1",
      "path": "syx/QuNexus/QuNexus Firmware v2.2.1_cs512.syx",
      "default": true,
      "latest": true,
      "notes": [
        "Chunk-safe (-cs512) packaging via QuNexus's SysEx_and_Hex_Images/make_sysex_app.ps1.",
        "Boot-tare capture for stuck keys, fixed pressure/bend/CC zeroing out at positive per-key sensitivity."
      ]
    }
  ],
  "profiles": [
    {
      "id": "legacy_unnamed_application",
      "state": "application",
      "productStrings": ["QuNexus"],
      "portLayout": {
        "style": "unnamed_ordered",
        "inputs": [
          { "index": 1, "role": "control_surface" },
          { "index": 2, "role": "expander" },
          { "index": 3, "role": "cv" }
        ],
        "outputs": [
          { "index": 1, "role": "control_surface" },
          { "index": 2, "role": "expander" },
          { "index": 3, "role": "cv" }
        ]
      }
    },
    {
      "id": "named_application",
      "state": "application",
      "productStrings": ["QuNexus"],
      "portLayout": {
        "style": "named",
        "inputs": [
          { "index": 1, "role": "control_surface", "name": "Control Surface" },
          { "index": 2, "role": "expander", "name": "Expander" },
          { "index": 3, "role": "cv", "name": "CV" }
        ],
        "outputs": [
          { "index": 1, "role": "control_surface", "name": "Control Surface" },
          { "index": 2, "role": "expander", "name": "Expander" },
          { "index": 3, "role": "cv", "name": "CV" }
        ]
      }
    },
    {
      "id": "bootloader",
      "state": "bootloader",
      "productStrings": ["QuNexus"],
      "portLayout": {
        "style": "unnamed_ordered",
        "inputs": [
          { "index": 1, "role": "bootloader" }
        ],
        "outputs": [
          { "index": 1, "role": "bootloader" }
        ]
      },
      "notes": [
        "Bootloader family matching remains passive first, then is confirmed by PID MSB = 1."
      ]
    }
  ]
}