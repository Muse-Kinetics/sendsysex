{
  "$schema": "../schemas/kmi_family.schema.json",
  "schemaVersion": 2,
  "id": "quneo",
  "name": "QuNeo",
  "summary": "Single-port family. Older firmware used QUNEO in all caps; newer firmware uses QuNeo. Bootloader is indicated by PID MSB = 1.",
  "discovery": {
    "familyMarkers": ["QUNEO", "QuNeo"],
    "safeProbeRoles": {
      "application": ["main"],
      "bootloader": ["bootloader", "main"]
    },
    "avoidProbeRoles": []
  },
  "identity": {
    "manufacturerId": [0, 1, 95],
    "applicationPidLsb": [30],
    "bootloaderPidLsb": [30],
    "stateDetection": {
      "applicationPidMsb": 0,
      "bootloaderPidMsb": 1
    }
  },
  "payloads": [
    {
      "id": "enter_bootloader",
      "type": "bootloader_entry",
      "targetState": "application",
      "path": "syx/QuNeo/QuNeo_enter_bootloader.syx",
      "notes": ["Requests a reboot into bootloader mode for QuNeo devices."]
    },
    {
      "id": "firmware_1_2_31",
      "type": "firmware",
      "targetState": "bootloader",
      "version": "1.2.31",
      "path": "syx/QuNeo/Quneo_Firmware_v1.2.31.syx",
      "notes": ["Single unchunked payload, superseded by firmware_1_2_31_chunked's chunk-safe packaging."]
    },
    {
      "id": "firmware_1_2_31_chunked",
      "type": "firmware",
      "targetState": "bootloader",
      "version": "1.2.31",
      "path": "syx/QuNeo/QuNeo Firmware v1.2.31_cs128.syx",
      "default": true,
      "latest": true,
      "notes": [
        "Chunk-safe (-cs128) packaging via the shared Hex_to_SysEx tool, built from quneo-firmware's SysEx_and_Hex_Images/make_sysex_app.ps1.",
        "Not yet confirmed on hardware - no QuNeo unit was connected when this payload was generated and packaging-validated (2026-07-28)."
      ]
    }
  ],
  "profiles": [
    {
      "id": "application",
      "state": "application",
      "productStrings": ["QuNeo", "QUNEO"],
      "portLayout": {
        "style": "single_port",
        "inputs": [
          { "index": 1, "role": "main" }
        ],
        "outputs": [
          { "index": 1, "role": "main" }
        ]
      }
    },
    {
      "id": "bootloader",
      "state": "bootloader",
      "productStrings": ["QuNeo", "QUNEO"],
      "portLayout": {
        "style": "single_port",
        "inputs": [
          { "index": 1, "role": "bootloader" }
        ],
        "outputs": [
          { "index": 1, "role": "bootloader" }
        ]
      }
    }
  ]
}