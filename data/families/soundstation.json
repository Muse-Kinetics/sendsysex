  "discovery": {
    "familyMarkers": ["SoundSTATION"],
    "safeProbeRoles": {
      "application": ["control"],
      "bootloader": []
    },
    "avoidProbeRoles": []
  },
  "identity": {
    "manufacturerId": [0, 1, 95],
    "applicationPidLsb": [48],
    "bootloaderPidLsb": [],
    "stateDetection": {
      "applicationPidMsb": 0,
      "bootloaderPidMsb": 1
    }
  },
  "payloads": [],
  "profiles": [
    {
      "id": "application",
      "state": "application",
      "productStrings": ["SoundSTATION"],
      "portLayout": {
        "style": "named",
        "inputs": [
          { "index": 1, "role": "control", "name": "Control" },
          { "index": 2, "role": "din", "name": "MIDI 5-pin DIN" }
        ],
        "outputs": [
          { "index": 1, "role": "control", "name": "Control" },
          { "index": 2, "role": "din", "name": "MIDI 5-pin DIN" }
        ]
      }
    }
  ]
