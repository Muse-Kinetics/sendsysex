{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KMI Device Manifest",
  "type": "object",
  "required": ["schemaVersion", "vendor", "matching", "families"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 2 },
    "status": { "type": "string" },
    "purpose": { "type": "object" },
    "vendor": {
      "type": "object",
      "required": ["name", "sysexManufacturerId"],
      "properties": {
        "name": { "type": "string" },
        "sysexManufacturerId": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "integer" }
        }
      }
    },
    "matching": {
      "type": "object",
      "required": ["strategy", "normalization"],
      "properties": {
        "strategy": { "type": "string" },
        "normalization": { "type": "object" },
        "windowsLegacyRules": { "type": "object" }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "file"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    }
  }
}