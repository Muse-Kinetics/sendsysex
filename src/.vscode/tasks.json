{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",  // g++.exe -v -Wall -Wextra -H -time -D__WINDOWS_MM__ "-I.\inc\rtmidi\" -fdiagnostics-color=always -fdiagnostics-show-option -g ".\SendSysEx.cpp" ".\inc\rtmidi\RtMidi.cpp" -o ".\SendSysEx.exe" -lwinmm
            "label": "Build SendSysEx",
            "command": "cmd",
            "args": [
                "/c",
                "chcp 65001 >nul && g++.exe",
                "-v",                        // Verbose output
                "-Wall",                     // Enable all warnings
                "-Wextra",                   // Enable extra warnings
                "-H",
                "-time",
                "-D__WINDOWS_MM__",
                "\"-I${workspaceFolder}\\inc\\rtmidi\\\"",
                "-fdiagnostics-color=always",
                "fdiagnostics-show-option",
                "-g",
                "\"${file}\"",
                "\"${workspaceFolder}\\inc\\rtmidi\\RtMidi.cpp\"",
                "-o",
                "\"${workspaceFolder}\\..\\Build\\Windows\\SendSysEx.exe\"",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the SendSysEx application."
        },
        {
            "label": "Open Build Folder",
            "type": "shell",
            "command": "explorer",
            "windows": {
               "command": "explorer",
               "args": ["${workspaceFolder}\\..\\Build\\Windows"]
            },
            "linux": {
               "command": "xdg-open",
               "args": ["${workspaceFolder}/../Build/Windows"]
            },
            "osx": {
               "command": "open",
               "args": ["${workspaceFolder}/../Build/Windows"]
            },
            "problemMatcher": [],
            "group": "none"
        }
    ]
}
